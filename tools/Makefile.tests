# Host-side tests for the two-stage launcher's planner. Builds the
# dashboard's own src/main/app_launch.c with the host compiler; no MIPS
# toolchain and no console required.
#
#   make -C tools -f Makefile.tests

CC     ?= cc
# The whole of app_launch.c is compiled here, launch paths included, so
# missing prototypes and type errors surface in seconds instead of ten
# minutes into a cross build. Only the MIPS inline asm is compiled out.
#
# The two -Wno- flags are for the console's 32-bit addresses being cast to
# pointers on a 64-bit host; they are correct on MIPS and noise here.
CFLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -I../src \
          -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast \
          -DAPP_LAUNCH_HOST_TEST -fsanitize=address,undefined
LDFLAGS := -fsanitize=address,undefined

.PHONY: all clean

all: build/test_app_launch
	@./build/test_app_launch

build:
	@mkdir -p build

build/test_app_launch: test_app_launch.c ../src/main/app_launch.c | build
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

clean:
	rm -rf build
